<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="AWTQuest.Site" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>AWTQuest</title>
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="bg-light">
    <form id="form1" runat="server">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" href="Default.aspx">🎮 AWTQuest</a>
                <div>
                    <a class="btn btn-outline-light me-2 fw-bold" href="Default.aspx">Home</a>
                    
                    <a class="btn btn-outline-light me-2 fw-bold" href="Dashboard.aspx">Dashboard</a>
                    
                    <a class="btn btn-outline-light me-2 fw-bold" href="Learn.aspx">Learn</a>
                    <a class="btn btn-primary fw-bold" href="Login.aspx">Login</a>
                </div>
            </div>
        </nav>

        <div class="container mt-4">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>